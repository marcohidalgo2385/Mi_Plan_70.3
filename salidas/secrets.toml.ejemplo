# PLANTILLA — copia estas claves en el panel "Secrets" de Streamlit Cloud
# (NO subas el secrets.toml real a GitHub; ya está en .gitignore)

gemini_api_key      = "TU_CLAVE_GEMINI"
strava_client_id    = "TU_CLIENT_ID_STRAVA"
strava_client_secret = "TU_CLIENT_SECRET_STRAVA"

# Al desplegar, pon aquí la URL pública de tu app (sin barra final):
redirect_uri = "https://TU-APP.streamlit.app"
